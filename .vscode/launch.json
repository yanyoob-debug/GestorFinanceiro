{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "FinTrackApplication",
      "request": "launch",
      "mainClass": "com.fintrack.FinTrackApplication",
      "projectName": "fintrack-backend"
    },
    {
      "name": "backend: iniciar",
      "type": "node-terminal",
      "request": "launch",
      "command": ".\\scripts\\run-backend.cmd",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "FinTrack",
        "order": 1
      }
    },
    {
      "name": "frontend: iniciar",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm start",
      "cwd": "${workspaceFolder}\\frontend",
      "presentation": {
        "group": "FinTrack",
        "order": 2
      }
    }
  ],
  "compounds": [
    {
      "name": "iniciar-tudo",
      "configurations": ["backend: iniciar", "frontend: iniciar"],
      "stopAll": true
    }
  ]
}
